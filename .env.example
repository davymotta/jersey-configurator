# Node.js 24+; never commit your real .env.
PORT=3000
SQLITE_PATH=./data/jersey.sqlite
# Required for production, e.g. https://jersey.example.com (no trailing slash).
# APP_ORIGIN=https://jersey.example.com
# Set to 1 only behind your trusted, single-hop HTTPS reverse proxy.
TRUST_PROXY=0
